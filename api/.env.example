# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgres://ecom_user:ecom_pass@localhost:5432/ecommerce_db

# ── Cache / Sessions (Redis) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Front-end (used in email links) ──────────────────────────────────────────
# Point this at your actual front-end URL so activation/reset links work
FRONTEND_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_ENDPOINT_SECRET=whsec_replace_me

# ── GCS media/static storage (only needed in production) ─────────────────────
# No key file needed — auth is ambient via the GCE VM's attached service
# account (Application Default Credentials through the metadata server).
# Leave USE_GCS=False for local dev (filesystem storage instead).
USE_GCS=False
GS_BUCKET_NAME=shopnow-media

# ── Sentry (optional) ────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CSRF (only needed in production, behind a proxy) ──────────────────────────
CSRF_TRUSTED_ORIGINS=https://shopnow.johnisah.com
